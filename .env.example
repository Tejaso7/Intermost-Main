# Docker Compose Environment Variables
# Copy this file to .env and update with your values

# ===== DJANGO/BACKEND =====
SECRET_KEY=your-super-secret-key-here-change-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,backend,intermost.in,www.intermost.in

# MongoDB Configuration
MONGODB_URI=mongodb://admin:password@mongodb:27017/intermost_db?authSource=admin
MONGODB_NAME=intermost_db

# MongoDB Setup (if using local MongoDB in Docker)
MONGO_USER=admin
MONGO_PASSWORD=password

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ACCESS_TOKEN_LIFETIME=86400
JWT_REFRESH_TOKEN_LIFETIME=604800

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://frontend:3000,https://intermost.in,https://www.intermost.in

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True

# Security Settings
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Logging
DJANGO_LOG_LEVEL=INFO

# ===== NEXT.JS/FRONTEND =====
NODE_ENV=production
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===== PRODUCTION ONLY =====
# Uncomment and update these for production deployment:
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# DEBUG=False
# CORS_ALLOWED_ORIGINS=https://intermost.in,https://www.intermost.in,https://api.intermost.in
# NEXT_PUBLIC_API_URL=https://api.intermost.in
# NEXT_PUBLIC_SITE_URL=https://intermost.in
